# ── AWS ───────────────────────────────────────────────────────────────────────
# IAM access key used by boto3 to authenticate with AWS
AWS_ACCESS_KEY_ID=your_access_key_here

# IAM secret key paired with the access key above
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# S3 bucket where raw stock JSON files and anomaly results are stored
AWS_BUCKET_NAME=your-stock-pipeline-bucket

# AWS region where the S3 bucket lives
AWS_REGION=us-east-1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Username for the Postgres database (used by both the pipeline and Airflow)
POSTGRES_USER=pipeline_user

# Password for the Postgres user above
POSTGRES_PASSWORD=changeme

# Name of the database where raw stock data is staged
POSTGRES_DB=stock_pipeline

# Hostname of the Postgres server (use 'postgres' when running via Docker Compose)
POSTGRES_HOST=postgres

# Port Postgres listens on
POSTGRES_PORT=5432

# ── OpenAI ───────────────────────────────────────────────────────────────────
# OpenAI API key for LLM market insights
OPENAI_API_KEY=your-openai-api-key-here

# ── Airflow ───────────────────────────────────────────────────────────────────
# Airflow database connection (matches the Postgres vars above)
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://pipeline_user:changeme@postgres/stock_pipeline

# Task executor — LocalExecutor runs tasks in subprocesses on the same machine
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# UID of the host user running Airflow containers (run: id -u to find yours)
AIRFLOW_UID=50000

# Username for the Airflow web UI admin account
AIRFLOW_ADMIN_USER=admin

# Password for the Airflow web UI admin account
AIRFLOW_ADMIN_PASSWORD=admin
