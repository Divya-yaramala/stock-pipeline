# === REQUIRED ===

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=your-s3-bucket-name
AWS_REGION=us-east-1

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=stock_pipeline

# Snowflake
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-snowflake-username
SNOWFLAKE_PASSWORD=your-snowflake-password
SNOWFLAKE_WAREHOUSE=STOCK_PIPELINE_WH
SNOWFLAKE_DATABASE=STOCK_PIPELINE_DB
SNOWFLAKE_SCHEMA=MARTS
SNOWFLAKE_ROLE=SYSADMIN

# === OPTIONAL ===

# OpenAI (for GPT market insights)
OPENAI_API_KEY=your-openai-api-key

# Slack (for pipeline alerts)
SLACK_WEBHOOK_URL=your-slack-webhook-url

# News API (for sentiment analysis)
NEWS_API_KEY=your-news-api-key

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
REPORT_EMAIL_TO=your-email@gmail.com

# Kafka (for real-time streaming layer)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_STOCK_PRICES=stock-prices
KAFKA_TOPIC_STOCK_ALERTS=stock-alerts

# Chaos Engineering (never enable in production!)
CHAOS_ENABLED=false

# ── Airflow ───────────────────────────────────────────────────────────────────
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:your-postgres-password@localhost/stock_pipeline
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
